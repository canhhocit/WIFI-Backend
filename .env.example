# Database Configuration
POSTGRES_DB=wifi_captive_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/wifi_captive_db

# Backend Configuration
SERVER_PORT=8080
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_HOURS=24

# Initial Admin Bootstrap (Local Development Only)
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=admin123
ADMIN_BOOTSTRAP_EMAIL=admin@captive.local

# Gateway Configuration
GATEWAY_ADAPTER_TYPE=mock
GATEWAY_SIMULATE_FAILURES=false
GATEWAY_SIMULATE_LATENCY_MS=150

# OPNsense Hardware Configuration (Optional for real hardware lab)
# OPNSENSE_API_URL=https://192.168.1.1/api/captiveportal
# OPNSENSE_API_KEY=your_api_key

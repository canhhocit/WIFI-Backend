# ==============================================================================
# WI-FI CAPTIVE PORTAL BACKEND - LOCAL DEVELOPMENT CONFIGURATION TEMPLATE
# Copy to .env for local development: cp .env.example .env
# ==============================================================================

# Database Configuration
POSTGRES_DB=wifi_captive_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/wifi_captive_db

# Backend Configuration
SERVER_PORT=8080
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_HOURS=24

# Initial Admin Bootstrap (Local Development Only)
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=admin123
ADMIN_BOOTSTRAP_EMAIL=admin@captive.local

# Gateway Configuration
# Options: 'gwn_cloud' (Grandstream GWN7001 via GDMS Cloud), 'mock' (local simulator), 'opnsense'
GATEWAY_ADAPTER_TYPE=gwn_cloud
GATEWAY_SIMULATE_FAILURES=false
GATEWAY_SIMULATE_LATENCY_MS=100

# Grandstream GWN7001 & GDMS Cloud Configuration
# Portal: https://www.gdms.cloud (hoặc https://www.gwn.cloud)
# Đăng ký OpenAPI App tại: Organization > Plan > OpenAPI / API Management
GWN_CLOUD_BASE_URL=https://www.gdms.cloud
GWN_CLOUD_APP_ID=
GWN_CLOUD_APP_SECRET=
GWN_CLOUD_NETWORK_ID=

# OPNsense Hardware Configuration (Dự phòng nếu dùng tường lửa OPNsense)
# OPNSENSE_API_URL=https://192.168.1.1/api/captiveportal
# OPNSENSE_API_KEY=your_api_key
# OPNSENSE_API_SECRET=your_api_secret

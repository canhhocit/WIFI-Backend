# ==============================================================================
# WI-FI CAPTIVE PORTAL BACKEND - LOCAL DEVELOPMENT CONFIGURATION TEMPLATE
# Copy to .env for local development: cp .env.example .env
# ==============================================================================

# Database Configuration (Company PostgreSQL Server)
POSTGRES_DB=wifi_haiphong
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Dnt@#$123!
POSTGRES_PORT=1032
SPRING_DATASOURCE_URL=jdbc:postgresql://118.70.117.152:1032/wifi_haiphong

# Backend Configuration
SERVER_PORT=8081
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_HOURS=24

# Initial Admin Bootstrap (Local Development Only)
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=admin123
ADMIN_BOOTSTRAP_EMAIL=admin@captive.local

# Gateway Configuration
# Options: 'gwn_cloud' (Grandstream GWN7001 via GDMS Cloud), 'mock' (local simulator), 'opnsense'
GATEWAY_ADAPTER_TYPE=gwn_cloud
GATEWAY_SIMULATE_FAILURES=false
GATEWAY_SIMULATE_LATENCY_MS=100

# Grandstream GWN7001 & GDMS Cloud Configuration
# Portal: https://www.gdms.cloud (hoặc https://www.gwn.cloud)
# Đăng ký OpenAPI App tại: Organization > Plan > OpenAPI / API Management
GWN_CLOUD_BASE_URL=https://www.gdms.cloud
GWN_CLOUD_APP_ID=
GWN_CLOUD_APP_SECRET=
GWN_CLOUD_NETWORK_ID=

# OPNsense Hardware Configuration (Dự phòng nếu dùng tường lửa OPNsense)
# OPNSENSE_API_URL=https://192.168.1.1/api/captiveportal
# OPNSENSE_API_KEY=your_api_key
# OPNSENSE_API_SECRET=your_api_secret

# MinIO S3 Object Storage Configuration
MINIO_ENABLED=true
MINIO_ENDPOINT=https://minio.phuchoangmai.xyz
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_BUCKET=wifi-haiphong
MINIO_PUBLIC_URL=https://minio.phuchoangmai.xyz/wifi-haiphong

# Giám sát trực tiếp mesh AP (cần đường mạng LAN/VPN tới điểm phát)
MESH_AP_ENABLED=false
MESH_AP_USERNAME=admin
# Mật khẩu quản lý chung: lần đầu đăng nhập bằng S/N (import danh sách bàn giao) rồi tự đổi sang mật khẩu này.
# Đặt qua secret, không commit giá trị thật. Để trống = giữ S/N làm mật khẩu.
MESH_AP_MANAGED_PASSWORD=
MESH_AP_ROTATE_FACTORY_PASSWORD=true
MESH_AP_POLL_INTERVAL_MS=60000
# Agent tại điểm phát: SHA-256 (hex) của token agent. Tạo: python -c "import hashlib;print(hashlib.sha256(b'TOKEN').hexdigest())"
MESH_AGENT_TOKEN_SHA256=
MESH_AGENT_STALE_AFTER_MS=300000
# true = mesh tu push len se tu dang ky AP moi (khong can khai bao tay tung diem). false = chi nhan AP da khai bao.
MESH_AGENT_AUTO_PROVISION=true
# true = suy ra on/off cua mesh tu GWN Cloud client/info (mesh hien nhu client noi cong LAN cua GWN7002).
MESH_GWN_STATUS_ENABLED=true
MESH_GWN_POLL_INTERVAL_MS=120000
# Khai cong LAN GWN cua tung mesh (on/off chinh xac khi nhieu mesh/1 GWN). Dang "MAC=cong,MAC=cong".
MESH_GWN_PORT_MAP=
